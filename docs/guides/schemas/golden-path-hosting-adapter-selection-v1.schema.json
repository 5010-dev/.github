{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5010-dev:golden-path:hosting-adapter-selection:v1",
  "title": "Golden Path hosting adapter selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "baseline",
    "adapters"
  ],
  "properties": {
    "schemaVersion": {
      "const": "golden-path-hosting-adapter-selection/v1"
    },
    "baseline": {
      "const": "github-free-private"
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/adapter"
      }
    }
  },
  "$defs": {
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "owner",
        "scope",
        "expectedOutcome",
        "evidence",
        "reviewBy",
        "rollback"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "state": {
          "enum": [
            "pilot",
            "enabled",
            "rollback",
            "disabled"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "expectedOutcome": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "format": "uri"
        },
        "enabledAt": {
          "type": "string",
          "format": "date"
        },
        "reviewBy": {
          "type": "string",
          "format": "date"
        },
        "rollback": {
          "$ref": "#/$defs/rollback"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "pilot",
                  "enabled",
                  "rollback"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "enabledAt"
            ]
          }
        }
      ]
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "action"
      ],
      "properties": {
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
