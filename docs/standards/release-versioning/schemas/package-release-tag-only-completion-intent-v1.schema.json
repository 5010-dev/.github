{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5010-dev:release-versioning:schema:package-release-tag-only-completion-intent:v1",
  "title": "Package release tag-only completion intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseUnit",
    "channel",
    "version",
    "originalIntentPath",
    "tag",
    "distTag",
    "failedPublication",
    "retainedArtifact",
    "source",
    "reason"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "channel": {
            "const": "prerelease"
          }
        }
      },
      "then": {
        "properties": {
          "version": {
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "channel": {
            "const": "final"
          }
        }
      },
      "then": {
        "properties": {
          "version": {
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
          }
        }
      }
    }
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": "package-release-tag-only-completion-intent/v1"
    },
    "releaseUnit": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "channel": {
      "enum": [
        "prerelease",
        "final"
      ]
    },
    "version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "originalIntentPath": {
      "$ref": "#/$defs/jsonPath"
    },
    "tag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\s]+$"
    },
    "distTag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\s]+$"
    },
    "failedPublication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCommit",
        "workflowRunUrl",
        "runAttempt",
        "outcome",
        "publicationState",
        "tagState",
        "registryVersionState",
        "authorization"
      ],
      "properties": {
        "sourceCommit": {
          "$ref": "#/$defs/fullCommit"
        },
        "workflowRunUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/[^/\\s]+/[^/\\s]+/actions/runs/[1-9][0-9]*$"
        },
        "runAttempt": {
          "type": "integer",
          "const": 1
        },
        "outcome": {
          "const": "terminal-failure"
        },
        "publicationState": {
          "const": "tag-only"
        },
        "tagState": {
          "const": "present"
        },
        "registryVersionState": {
          "const": "absent"
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path"
          ],
          "properties": {
            "type": {
              "enum": [
                "release-intent",
                "pre-mutation-recovery"
              ]
            },
            "path": {
              "$ref": "#/$defs/jsonPath"
            }
          }
        }
      }
    },
    "retainedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "artifactName",
        "expiresAt",
        "archiveDigest",
        "tarballFileName",
        "tarballSha256",
        "npmIntegrity",
        "embeddedSourceCommit"
      ],
      "properties": {
        "artifactId": {
          "type": "integer",
          "minimum": 1
        },
        "artifactName": {
          "$ref": "#/$defs/fileName"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "archiveDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "tarballFileName": {
          "type": "string",
          "minLength": 5,
          "maxLength": 255,
          "pattern": "^(?!.*[/\\\\])[^\\u0000-\\u001F\\u007F]+\\.tgz$"
        },
        "tarballSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "npmIntegrity": {
          "type": "string",
          "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"
        },
        "embeddedSourceCommit": {
          "$ref": "#/$defs/fullCommit"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "baseCommit"
      ],
      "properties": {
        "ref": {
          "const": "refs/heads/dev"
        },
        "baseCommit": {
          "$ref": "#/$defs/fullCommit"
        }
      }
    },
    "reason": {
      "const": "tag-only-partial-publication"
    }
  },
  "$defs": {
    "fullCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "jsonPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!:)(?!/)(?!.*[\\u0000-\\u001F\\u007F])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\*)(?!.*\\?)(?!.*\\[).+\\.json$"
    },
    "fileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!.*[/\\\\])[^\\u0000-\\u001F\\u007F]+$"
    }
  }
}
