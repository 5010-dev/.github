{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5010-dev:release-versioning:schema:package-release-recovery-intent:v1",
  "title": "Package release recovery intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseUnit",
    "channel",
    "version",
    "originalIntentPath",
    "failedAttempt",
    "source",
    "reason"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "channel": {
            "const": "prerelease"
          }
        }
      },
      "then": {
        "properties": {
          "version": {
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "channel": {
            "const": "final"
          }
        }
      },
      "then": {
        "properties": {
          "version": {
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
          }
        }
      }
    }
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": "package-release-recovery-intent/v1"
    },
    "releaseUnit": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "channel": {
      "enum": [
        "prerelease",
        "final"
      ]
    },
    "version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "originalIntentPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!:)(?!/)(?!.*[\\u0000-\\u001F\\u007F])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\*)(?!.*\\?)(?!.*\\[).+\\.json$"
    },
    "failedAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCommit",
        "workflowRunUrl",
        "outcome",
        "mutationState",
        "tagState",
        "registryVersionState"
      ],
      "properties": {
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "workflowRunUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/[^/\\s]+/[^/\\s]+/actions/runs/[1-9][0-9]*$"
        },
        "outcome": {
          "const": "terminal-failure"
        },
        "mutationState": {
          "const": "not-started"
        },
        "tagState": {
          "const": "absent"
        },
        "registryVersionState": {
          "const": "absent"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "baseCommit"
      ],
      "properties": {
        "ref": {
          "const": "refs/heads/dev"
        },
        "baseCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "reason": {
      "const": "pre-mutation-no-immutable-identity"
    }
  }
}
