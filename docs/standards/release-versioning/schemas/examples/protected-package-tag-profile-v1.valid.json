{
  "schemaVersion": "protected-package-tag-profile/v1",
  "profile": "protected-package-tag",
  "source": {
    "branch": "dev",
    "ref": "refs/heads/dev",
    "admissionEvent": "push"
  },
  "intentDirectory": ".github/release-intents",
  "recovery": {
    "intentDirectory": ".github/release-recovery-intents",
    "workflow": ".github/workflows/publish-browser-package.yml"
  },
  "tagOnlyCompletion": {
    "intentDirectory": ".github/release-tag-only-completion-intents",
    "workflow": ".github/workflows/complete-browser-package.yml",
    "jobPermissions": {
      "admissionAndLiveVerification": [
        "contents: read",
        "actions: read",
        "pull-requests: read",
        "packages: read"
      ],
      "retainedArtifactRetrieval": [
        "actions: read"
      ],
      "registryMutation": [
        "packages: write"
      ],
      "postPublicationVerification": [
        "contents: read",
        "packages: read"
      ]
    },
    "publicationEffects": {
      "allowed": [
        "registry-package-publication"
      ],
      "forbidden": [
        "package-tag-creation",
        "branch-push",
        "source-commit",
        "service-deployment",
        "application-deployment",
        "oci-publication",
        "object-storage-publication",
        "sibling-release-unit-mutation"
      ]
    },
    "stateOutcomes": {
      "exactTagRegistryAbsent": "publish-eligible",
      "exactPair": "verification-only",
      "tagMissingMovedOrConflicting": "fail-closed",
      "registryOnlyMismatchedOrAmbiguous": "fail-closed",
      "artifactMissing": "fail-closed",
      "artifactExpired": "fail-closed",
      "artifactMismatched": "fail-closed"
    }
  },
  "tagOnlyCompletionRecovery": {
    "intentDirectory": ".github/release-tag-only-completion-recovery-intents",
    "workflow": ".github/workflows/recover-browser-package-completion.yml",
    "jobPermissions": {
      "admissionAndLiveVerification": [
        "contents: read",
        "actions: read",
        "pull-requests: read",
        "packages: read"
      ],
      "retainedArtifactRetrieval": [
        "actions: read"
      ],
      "registryMutation": [
        "packages: write"
      ],
      "postPublicationVerification": [
        "contents: read",
        "packages: read"
      ]
    },
    "permissionPreflight": {
      "workflow": ".github/workflows/validate-browser-package.yml",
      "jobPermissions": [
        "contents: read",
        "actions: read",
        "pull-requests: read",
        "packages: read"
      ],
      "endpointPermissions": [
        {
          "endpoint": "actions-run-metadata",
          "permission": "actions: read"
        },
        {
          "endpoint": "actions-job-metadata",
          "permission": "actions: read"
        },
        {
          "endpoint": "actions-artifact-metadata",
          "permission": "actions: read"
        },
        {
          "endpoint": "completion-workflow-run-history",
          "permission": "actions: read"
        },
        {
          "endpoint": "commit-associated-pull-requests",
          "permission": "pull-requests: read"
        },
        {
          "endpoint": "git-tag-ref",
          "permission": "contents: read"
        },
        {
          "endpoint": "registry-version-and-dist-tag",
          "permission": "packages: read"
        }
      ],
      "credentials": {
        "allowed": [
          "github-token"
        ],
        "forbidden": [
          "tag-app-credential",
          "registry-write-credential"
        ]
      },
      "publicationEffects": {
        "allowed": [],
        "forbidden": [
          "registry-package-publication",
          "package-tag-creation",
          "branch-push",
          "source-commit",
          "artifact-creation",
          "service-deployment",
          "application-deployment",
          "oci-publication",
          "object-storage-publication",
          "sibling-release-unit-mutation"
        ]
      }
    },
    "publicationEffects": {
      "allowed": [
        "registry-package-publication"
      ],
      "forbidden": [
        "package-tag-creation",
        "branch-push",
        "source-commit",
        "service-deployment",
        "application-deployment",
        "oci-publication",
        "object-storage-publication",
        "sibling-release-unit-mutation"
      ]
    },
    "stateOutcomes": {
      "exactTagRegistryAbsent": "publish-eligible",
      "exactPair": "verification-only",
      "tagMissingMovedOrConflicting": "fail-closed",
      "registryOnlyMismatchedOrAmbiguous": "fail-closed",
      "artifactMissing": "fail-closed",
      "artifactExpired": "fail-closed",
      "artifactMismatched": "fail-closed",
      "predecessorFirstRunAttemptOne": "recovery-eligible",
      "predecessorRerunOrLaterRun": "fail-closed"
    }
  },
  "releaseUnit": {
    "id": "example-browser-package",
    "artifactProfile": "registry-package",
    "packageName": "@example/browser-package",
    "registry": "https://packages.example.invalid",
    "compatibilityContract": "docs/browser-package.md",
    "buildClosure": [
      "packages/browser/**",
      "crates/shared/**"
    ],
    "versionSource": {
      "type": "json-pointer",
      "path": "packages/browser/package.json",
      "versionPointer": "/version",
      "packageNamePointer": "/name"
    },
    "changelog": "packages/browser/CHANGELOG.md",
    "tagPattern": "browser-package-v{version}",
    "validationWorkflow": ".github/workflows/validate-browser-package.yml",
    "publicationWorkflow": ".github/workflows/publish-browser-package.yml",
    "releasePreparationPaths": [
      ".github/release-intents/*.json",
      "packages/browser/package.json",
      "packages/browser/CHANGELOG.md",
      "docs/release-support/**"
    ]
  },
  "siblingReleaseUnits": [
    {
      "id": "example-calculator-service",
      "kind": "service",
      "mutationPaths": [
        "services/calculator/**",
        ".github/workflows/deploy-calculator.yml"
      ]
    }
  ],
  "channels": {
    "prerelease": {
      "distTag": "next"
    },
    "final": {
      "distTag": "latest"
    }
  },
  "minimumPermissions": {
    "validation": [
      "contents: read"
    ],
    "consumption": [
      "packages: read"
    ],
    "publication": [
      "packages: write"
    ]
  },
  "publicationEffects": {
    "allowed": [
      "package-tag-creation",
      "registry-package-publication"
    ],
    "forbidden": [
      "branch-push",
      "source-commit",
      "service-deployment",
      "application-deployment",
      "oci-publication",
      "object-storage-publication",
      "sibling-release-unit-mutation"
    ]
  },
  "serialization": {
    "scope": "release-unit-version",
    "cancelInProgress": false
  },
  "owners": {
    "release": "example-release-maintainers",
    "credentials": "example-security-maintainers",
    "recovery": "example-release-maintainers"
  }
}
