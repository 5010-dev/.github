{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5010-dev:release-versioning:schema:protected-package-tag-profile:v1",
  "title": "Protected package-tag profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "source",
    "intentDirectory",
    "recovery",
    "tagOnlyCompletion",
    "tagOnlyCompletionRecovery",
    "releaseUnit",
    "siblingReleaseUnits",
    "channels",
    "minimumPermissions",
    "publicationEffects",
    "serialization",
    "owners"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": "protected-package-tag-profile/v1"
    },
    "profile": {
      "const": "protected-package-tag"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "ref",
        "admissionEvent"
      ],
      "properties": {
        "branch": {
          "const": "dev"
        },
        "ref": {
          "const": "refs/heads/dev"
        },
        "admissionEvent": {
          "const": "push"
        }
      }
    },
    "intentDirectory": {
      "$ref": "#/$defs/plainRelativePath"
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentDirectory",
        "workflow"
      ],
      "properties": {
        "intentDirectory": {
          "$ref": "#/$defs/plainRelativePath"
        },
        "workflow": {
          "$ref": "#/$defs/workflowPath"
        }
      }
    },
    "tagOnlyCompletion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentDirectory",
        "workflow",
        "jobPermissions",
        "publicationEffects",
        "stateOutcomes"
      ],
      "properties": {
        "intentDirectory": {
          "$ref": "#/$defs/plainRelativePath"
        },
        "workflow": {
          "$ref": "#/$defs/workflowPath"
        },
        "jobPermissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "admissionAndLiveVerification",
            "retainedArtifactRetrieval",
            "registryMutation",
            "postPublicationVerification"
          ],
          "properties": {
            "admissionAndLiveVerification": {
              "const": [
                "contents: read",
                "actions: read",
                "pull-requests: read",
                "packages: read"
              ]
            },
            "retainedArtifactRetrieval": {
              "const": [
                "actions: read"
              ]
            },
            "registryMutation": {
              "const": [
                "packages: write"
              ]
            },
            "postPublicationVerification": {
              "const": [
                "contents: read",
                "packages: read"
              ]
            }
          }
        },
        "publicationEffects": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed",
            "forbidden"
          ],
          "properties": {
            "allowed": {
              "const": [
                "registry-package-publication"
              ]
            },
            "forbidden": {
              "const": [
                "package-tag-creation",
                "branch-push",
                "source-commit",
                "service-deployment",
                "application-deployment",
                "oci-publication",
                "object-storage-publication",
                "sibling-release-unit-mutation"
              ]
            }
          }
        },
        "stateOutcomes": {
          "const": {
            "exactTagRegistryAbsent": "publish-eligible",
            "exactPair": "verification-only",
            "tagMissingMovedOrConflicting": "fail-closed",
            "registryOnlyMismatchedOrAmbiguous": "fail-closed",
            "artifactMissing": "fail-closed",
            "artifactExpired": "fail-closed",
            "artifactMismatched": "fail-closed"
          }
        }
      }
    },
    "tagOnlyCompletionRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentDirectory",
        "workflow",
        "jobPermissions",
        "permissionPreflight",
        "publicationEffects",
        "stateOutcomes"
      ],
      "properties": {
        "intentDirectory": {
          "$ref": "#/$defs/plainRelativePath"
        },
        "workflow": {
          "$ref": "#/$defs/workflowPath"
        },
        "jobPermissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "admissionAndLiveVerification",
            "retainedArtifactRetrieval",
            "registryMutation",
            "postPublicationVerification"
          ],
          "properties": {
            "admissionAndLiveVerification": {
              "const": [
                "contents: read",
                "actions: read",
                "pull-requests: read",
                "packages: read"
              ]
            },
            "retainedArtifactRetrieval": {
              "const": [
                "actions: read"
              ]
            },
            "registryMutation": {
              "const": [
                "packages: write"
              ]
            },
            "postPublicationVerification": {
              "const": [
                "contents: read",
                "packages: read"
              ]
            }
          }
        },
        "permissionPreflight": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workflow",
            "jobPermissions",
            "endpointPermissions",
            "credentials",
            "publicationEffects"
          ],
          "properties": {
            "workflow": {
              "$ref": "#/$defs/workflowPath"
            },
            "jobPermissions": {
              "const": [
                "contents: read",
                "actions: read",
                "pull-requests: read",
                "packages: read"
              ]
            },
            "endpointPermissions": {
              "type": "array",
              "minItems": 7,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/endpointPermission"
              },
              "allOf": [
                {
                  "contains": {
                    "const": {
                      "endpoint": "actions-run-metadata",
                      "permission": "actions: read"
                    }
                  }
                },
                {
                  "contains": {
                    "const": {
                      "endpoint": "actions-job-metadata",
                      "permission": "actions: read"
                    }
                  }
                },
                {
                  "contains": {
                    "const": {
                      "endpoint": "actions-artifact-metadata",
                      "permission": "actions: read"
                    }
                  }
                },
                {
                  "contains": {
                    "const": {
                      "endpoint": "completion-workflow-run-history",
                      "permission": "actions: read"
                    }
                  }
                },
                {
                  "contains": {
                    "const": {
                      "endpoint": "commit-associated-pull-requests",
                      "permission": "pull-requests: read"
                    }
                  }
                },
                {
                  "contains": {
                    "const": {
                      "endpoint": "git-tag-ref",
                      "permission": "contents: read"
                    }
                  }
                },
                {
                  "contains": {
                    "const": {
                      "endpoint": "registry-version-and-dist-tag",
                      "permission": "packages: read"
                    }
                  }
                }
              ]
            },
            "credentials": {
              "const": {
                "allowed": [
                  "github-token"
                ],
                "forbidden": [
                  "tag-app-credential",
                  "registry-write-credential"
                ]
              }
            },
            "publicationEffects": {
              "const": {
                "allowed": [],
                "forbidden": [
                  "registry-package-publication",
                  "package-tag-creation",
                  "branch-push",
                  "source-commit",
                  "artifact-creation",
                  "service-deployment",
                  "application-deployment",
                  "oci-publication",
                  "object-storage-publication",
                  "sibling-release-unit-mutation"
                ]
              }
            }
          }
        },
        "publicationEffects": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed",
            "forbidden"
          ],
          "properties": {
            "allowed": {
              "const": [
                "registry-package-publication"
              ]
            },
            "forbidden": {
              "const": [
                "package-tag-creation",
                "branch-push",
                "source-commit",
                "service-deployment",
                "application-deployment",
                "oci-publication",
                "object-storage-publication",
                "sibling-release-unit-mutation"
              ]
            }
          }
        },
        "stateOutcomes": {
          "const": {
            "exactTagRegistryAbsent": "publish-eligible",
            "exactPair": "verification-only",
            "tagMissingMovedOrConflicting": "fail-closed",
            "registryOnlyMismatchedOrAmbiguous": "fail-closed",
            "artifactMissing": "fail-closed",
            "artifactExpired": "fail-closed",
            "artifactMismatched": "fail-closed",
            "predecessorFirstRunAttemptOne": "recovery-eligible",
            "predecessorRerunOrLaterRun": "fail-closed"
          }
        }
      }
    },
    "releaseUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "artifactProfile",
        "packageName",
        "registry",
        "compatibilityContract",
        "buildClosure",
        "versionSource",
        "changelog",
        "tagPattern",
        "validationWorkflow",
        "publicationWorkflow",
        "releasePreparationPaths"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "artifactProfile": {
          "const": "registry-package"
        },
        "packageName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 214
        },
        "registry": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "compatibilityContract": {
          "$ref": "#/$defs/plainRelativePath"
        },
        "buildClosure": {
          "$ref": "#/$defs/pathPatterns"
        },
        "versionSource": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "path",
                "versionPointer",
                "packageNamePointer"
              ],
              "properties": {
                "type": {
                  "const": "json-pointer"
                },
                "path": {
                  "$ref": "#/$defs/plainRelativePath"
                },
                "versionPointer": {
                  "type": "string",
                  "pattern": "^/"
                },
                "packageNamePointer": {
                  "type": "string",
                  "pattern": "^/"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "path",
                "versionKey",
                "packageNameKey"
              ],
              "properties": {
                "type": {
                  "const": "toml-key"
                },
                "path": {
                  "$ref": "#/$defs/plainRelativePath"
                },
                "versionKey": {
                  "$ref": "#/$defs/tomlDottedKey"
                },
                "packageNameKey": {
                  "$ref": "#/$defs/tomlDottedKey"
                }
              }
            }
          ]
        },
        "changelog": {
          "$ref": "#/$defs/plainRelativePath"
        },
        "tagPattern": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200,
          "pattern": "^[^{}\\s]*\\{version\\}[^{}\\s]*$"
        },
        "validationWorkflow": {
          "$ref": "#/$defs/workflowPath"
        },
        "publicationWorkflow": {
          "$ref": "#/$defs/workflowPath"
        },
        "releasePreparationPaths": {
          "$ref": "#/$defs/pathPatterns"
        }
      }
    },
    "siblingReleaseUnits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "service",
              "application"
            ]
          }
        }
      },
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "mutationPaths"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "registry-package",
              "service",
              "application",
              "oci-image",
              "other"
            ]
          },
          "mutationPaths": {
            "$ref": "#/$defs/pathPatterns"
          }
        }
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prerelease",
        "final"
      ],
      "properties": {
        "prerelease": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "distTag"
          ],
          "properties": {
            "distTag": {
              "type": "string",
              "minLength": 1,
              "not": {
                "const": "latest"
              }
            }
          }
        },
        "final": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "distTag"
          ],
          "properties": {
            "distTag": {
              "const": "latest"
            }
          }
        }
      }
    },
    "minimumPermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation",
        "consumption",
        "publication"
      ],
      "properties": {
        "validation": {
          "const": [
            "contents: read"
          ]
        },
        "consumption": {
          "const": [
            "packages: read"
          ]
        },
        "publication": {
          "const": [
            "packages: write"
          ]
        }
      }
    },
    "publicationEffects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "forbidden"
      ],
      "properties": {
        "allowed": {
          "const": [
            "package-tag-creation",
            "registry-package-publication"
          ]
        },
        "forbidden": {
          "const": [
            "branch-push",
            "source-commit",
            "service-deployment",
            "application-deployment",
            "oci-publication",
            "object-storage-publication",
            "sibling-release-unit-mutation"
          ]
        }
      }
    },
    "serialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "cancelInProgress"
      ],
      "properties": {
        "scope": {
          "const": "release-unit-version"
        },
        "cancelInProgress": {
          "const": false
        }
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "credentials",
        "recovery"
      ],
      "properties": {
        "release": {
          "$ref": "#/$defs/owner"
        },
        "credentials": {
          "$ref": "#/$defs/owner"
        },
        "recovery": {
          "$ref": "#/$defs/owner"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "plainRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!:)(?!/)(?!.*[\\u0000-\\u001F\\u007F])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\*)(?!.*\\?)(?!.*\\[).+$"
    },
    "pathPattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!:)(?!/)(?!.*[\\u0000-\\u001F\\u007F])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "pathPatterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/pathPattern"
      }
    },
    "tomlDottedKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
    },
    "workflowPath": {
      "type": "string",
      "pattern": "^\\.github/workflows/[^/\\u0000-\\u001F\\u007F]+\\.ya?ml$"
    },
    "endpointPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "permission"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "permission": {
          "enum": [
            "contents: read",
            "actions: read",
            "pull-requests: read",
            "packages: read"
          ]
        }
      }
    }
  }
}
