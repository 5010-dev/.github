{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5010-dev:release-versioning:schema:protected-package-tag-profile:v1",
  "title": "Protected package-tag profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "source",
    "intentDirectory",
    "releaseUnit",
    "siblingReleaseUnits",
    "channels",
    "minimumPermissions",
    "publicationEffects",
    "serialization",
    "owners"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": "protected-package-tag-profile/v1"
    },
    "profile": {
      "const": "protected-package-tag"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "ref",
        "admissionEvent"
      ],
      "properties": {
        "branch": {
          "const": "dev"
        },
        "ref": {
          "const": "refs/heads/dev"
        },
        "admissionEvent": {
          "const": "push"
        }
      }
    },
    "intentDirectory": {
      "$ref": "#/$defs/plainRelativePath"
    },
    "releaseUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "artifactProfile",
        "packageName",
        "registry",
        "compatibilityContract",
        "buildClosure",
        "versionSource",
        "changelog",
        "tagPattern",
        "validationWorkflow",
        "publicationWorkflow",
        "releasePreparationPaths"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "artifactProfile": {
          "const": "registry-package"
        },
        "packageName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 214
        },
        "registry": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "compatibilityContract": {
          "$ref": "#/$defs/plainRelativePath"
        },
        "buildClosure": {
          "$ref": "#/$defs/pathPatterns"
        },
        "versionSource": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "path",
                "versionPointer",
                "packageNamePointer"
              ],
              "properties": {
                "type": {
                  "const": "json-pointer"
                },
                "path": {
                  "$ref": "#/$defs/plainRelativePath"
                },
                "versionPointer": {
                  "type": "string",
                  "pattern": "^/"
                },
                "packageNamePointer": {
                  "type": "string",
                  "pattern": "^/"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "path",
                "versionKey",
                "packageNameKey"
              ],
              "properties": {
                "type": {
                  "const": "toml-key"
                },
                "path": {
                  "$ref": "#/$defs/plainRelativePath"
                },
                "versionKey": {
                  "$ref": "#/$defs/tomlDottedKey"
                },
                "packageNameKey": {
                  "$ref": "#/$defs/tomlDottedKey"
                }
              }
            }
          ]
        },
        "changelog": {
          "$ref": "#/$defs/plainRelativePath"
        },
        "tagPattern": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200,
          "pattern": "^[^{}\\s]*\\{version\\}[^{}\\s]*$"
        },
        "validationWorkflow": {
          "$ref": "#/$defs/workflowPath"
        },
        "publicationWorkflow": {
          "$ref": "#/$defs/workflowPath"
        },
        "releasePreparationPaths": {
          "$ref": "#/$defs/pathPatterns"
        }
      }
    },
    "siblingReleaseUnits": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "service",
              "application"
            ]
          }
        }
      },
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "mutationPaths"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "registry-package",
              "service",
              "application",
              "oci-image",
              "other"
            ]
          },
          "mutationPaths": {
            "$ref": "#/$defs/pathPatterns"
          }
        }
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prerelease",
        "final"
      ],
      "properties": {
        "prerelease": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "distTag"
          ],
          "properties": {
            "distTag": {
              "type": "string",
              "minLength": 1,
              "not": {
                "const": "latest"
              }
            }
          }
        },
        "final": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "distTag"
          ],
          "properties": {
            "distTag": {
              "const": "latest"
            }
          }
        }
      }
    },
    "minimumPermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation",
        "consumption",
        "publication"
      ],
      "properties": {
        "validation": {
          "const": [
            "contents: read"
          ]
        },
        "consumption": {
          "const": [
            "packages: read"
          ]
        },
        "publication": {
          "const": [
            "packages: write"
          ]
        }
      }
    },
    "publicationEffects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "forbidden"
      ],
      "properties": {
        "allowed": {
          "const": [
            "package-tag-creation",
            "registry-package-publication"
          ]
        },
        "forbidden": {
          "const": [
            "branch-push",
            "source-commit",
            "service-deployment",
            "application-deployment",
            "oci-publication",
            "object-storage-publication",
            "sibling-release-unit-mutation"
          ]
        }
      }
    },
    "serialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "cancelInProgress"
      ],
      "properties": {
        "scope": {
          "const": "release-unit-version"
        },
        "cancelInProgress": {
          "const": false
        }
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "credentials",
        "recovery"
      ],
      "properties": {
        "release": {
          "$ref": "#/$defs/owner"
        },
        "credentials": {
          "$ref": "#/$defs/owner"
        },
        "recovery": {
          "$ref": "#/$defs/owner"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "plainRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\*)(?!.*\\?)(?!.*\\[).+$"
    },
    "pathPattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "pathPatterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/pathPattern"
      }
    },
    "tomlDottedKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
    },
    "workflowPath": {
      "type": "string",
      "pattern": "^\\.github/workflows/[^/]+\\.ya?ml$"
    }
  }
}
