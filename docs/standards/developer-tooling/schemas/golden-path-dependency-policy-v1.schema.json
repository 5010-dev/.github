{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5010-dev:golden-path:golden-path-dependency-policy:v1",
  "title": "Golden Path dependency policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseUnits", "defaults", "roots"],
  "properties": {
    "schemaVersion": {"const": "golden-path-dependency-policy/v1"},
    "releaseUnits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "const": ".github/release-units.json"}
      }
    },
    "adapter": {"type": "string", "enum": ["dependabot", "renovate"]},
    "defaults": {"$ref": "#/$defs/rootPolicy"},
    "roots": {
      "type": "array",
      "items": {"$ref": "#/$defs/rootBinding"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "date": {"type": "string", "format": "date"},
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": {"type": "string", "enum": ["team", "codeowners", "github-user", "operational-queue"]},
        "reference": {"type": "string", "minLength": 1}
      }
    },
    "releaseFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integrationBranch", "releaseBranch"],
      "properties": {
        "integrationBranch": {"type": "string", "minLength": 1},
        "releaseBranch": {"type": "string", "minLength": 1}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "workingDirectory", "recipe"],
      "properties": {
        "kind": {"const": "just-recipe"},
        "workingDirectory": {"type": "string", "minLength": 1},
        "recipe": {"const": "ci"}
      }
    },
    "ciEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "workflow", "job"],
      "properties": {
        "kind": {"const": "github-actions-job"},
        "workflow": {"type": "string", "pattern": "^\\.github/workflows/[^/]+\\.ya?ml$"},
        "job": {"type": "string", "minLength": 1}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {"$ref": "#/$defs/command"},
        "ciEvidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/ciEvidence"},
          "uniqueItems": true
        }
      }
    },
    "routine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prBudget": {"type": "integer", "minimum": 1},
        "budgetOverride": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "owner", "reviewAfter"],
          "properties": {
            "reason": {"type": "string", "minLength": 1},
            "owner": {"$ref": "#/$defs/owner"},
            "reviewAfter": {"$ref": "#/$defs/date"}
          }
        }
      }
    },
    "securityRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner"],
      "properties": {
        "owner": {"$ref": "#/$defs/owner"},
        "canonicalGate": {"$ref": "#/$defs/gate"},
        "manualRemediation": {"type": "string", "minLength": 1}
      },
      "anyOf": [
        {"required": ["canonicalGate"]},
        {"required": ["manualRemediation"]}
      ]
    },
    "rootPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "releaseFlow", "canonicalGate", "routine", "securityFallback"],
      "properties": {
        "owner": {"$ref": "#/$defs/owner"},
        "releaseFlow": {"$ref": "#/$defs/releaseFlow"},
        "canonicalGate": {"$ref": "#/$defs/gate"},
        "routine": {"$ref": "#/$defs/routine"},
        "securityFallback": {"$ref": "#/$defs/securityRoute"}
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "releaseUnitId"],
      "properties": {
        "kind": {"type": "string", "enum": ["contract", "migration"]},
        "releaseUnitId": {"$ref": "#/$defs/identifier"}
      }
    },
    "rootBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootId", "classification"],
      "properties": {
        "rootId": {"$ref": "#/$defs/identifier"},
        "classification": {"type": "string", "enum": ["classified", "pending-classification"]},
        "affectedReleaseUnits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "validationOnly": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/invariant"}
        },
        "owner": {"$ref": "#/$defs/owner"},
        "releaseFlow": {"$ref": "#/$defs/releaseFlow"},
        "canonicalGate": {"$ref": "#/$defs/gate"},
        "routine": {"$ref": "#/$defs/routine"},
        "security": {"$ref": "#/$defs/securityRoute"},
        "reason": {"type": "string", "minLength": 1},
        "reviewAfter": {"$ref": "#/$defs/date"}
      },
      "anyOf": [
        {
          "properties": {"classification": {"const": "classified"}},
          "required": ["affectedReleaseUnits"]
        },
        {
          "properties": {"classification": {"const": "pending-classification"}},
          "required": ["reason", "owner", "reviewAfter"]
        }
      ]
    }
  }
}
