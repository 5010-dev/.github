{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/5010-dev/.github/schemas/golden-path-rule-catalog/v1",
  "title": "Golden Path stable rule catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "standardVersion",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": "golden-path-rule-catalog/v1"
    },
    "contractVersion": {
      "const": "golden-path/v1"
    },
    "standardVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.(0[1-9]|1[0-2])(?:\\.[1-9][0-9]*)?$"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "level",
        "source",
        "applicability",
        "assessment",
        "severity",
        "waivable",
        "highRisk",
        "assertion",
        "remediation",
        "introducedIn",
        "retiredIn",
        "replacement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DT-[A-Z]+-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "level": {
          "enum": [
            "MUST",
            "MUST_NOT",
            "SHOULD",
            "SHOULD_NOT",
            "MAY"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "document",
            "anchor"
          ],
          "properties": {
            "decision": {
              "type": "string",
              "pattern": "^GP-(00[6-9]|01[0-9]|020)$"
            },
            "document": {
              "type": "string",
              "pattern": "^(?!/)(?!.*\\.\\./).+\\.md$"
            },
            "anchor": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          }
        },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profiles",
            "artifactTypes",
            "capabilities",
            "condition"
          ],
          "properties": {
            "profiles": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "artifactTypes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "capabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "condition": {
              "type": "string",
              "minLength": 3,
              "maxLength": 1000
            }
          }
        },
        "assessment": {
          "enum": [
            "automated",
            "manual",
            "hybrid"
          ]
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "waivable": {
          "type": "boolean"
        },
        "highRisk": {
          "type": "boolean"
        },
        "assertion": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "remediation": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "introducedIn": {
          "type": "string",
          "pattern": "^[0-9]{4}\\.(0[1-9]|1[0-2])(?:\\.[1-9][0-9]*)?$"
        },
        "retiredIn": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}\\.(0[1-9]|1[0-2])(?:\\.[1-9][0-9]*)?$"
        },
        "replacement": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^DT-[A-Z]+-[0-9]{3}$"
        }
      }
    }
  }
}
