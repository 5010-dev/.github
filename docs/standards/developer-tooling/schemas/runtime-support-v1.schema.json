{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/5010-dev/.github/schemas/runtime-support/v1",
  "title": "Golden Path runtime support catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "standardVersion",
    "asOf",
    "profiles",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": "runtime-support/v1"
    },
    "standardVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.(0[1-9]|1[0-2])(?:\\.[1-9][0-9]*)?$"
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceIds",
        "versions"
      ],
      "properties": {
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/version"
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "upstreamLifecycle",
        "organizationDisposition",
        "migrationState"
      ],
      "properties": {
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "upstreamLifecycle": {
          "enum": [
            "current",
            "active",
            "maintenance",
            "security",
            "prerelease",
            "eol",
            "unknown"
          ]
        },
        "organizationDisposition": {
          "enum": [
            "preferred",
            "supported",
            "compatibility-only",
            "blocked"
          ]
        },
        "migrationState": {
          "enum": [
            "none",
            "warning",
            "required",
            "exception",
            "evaluation-only"
          ]
        },
        "supportEndsAt": {
          "type": "string",
          "format": "date"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "checkedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "checkedAt": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
